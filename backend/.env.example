# ==============================================================================
# BACKEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env.development or .env.production and adjust the values.
# NEVER commit the actual .env file or production secrets to source control.

# Application Environment (development, production, test)
NODE_ENV=development

# Server Port
PORT=5000

# MongoDB Connection String (MongoDB Atlas or local instance)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb+srv://db_user:secure_password_here@cluster0.zudolum.mongodb.net/loan_app?retryWrites=true&w=majority

# JWT Configurations (Keys must be strong random secrets)
# Tip: Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=8f54c9c75567b4db1b138676dc4c55d0a6c0b3952f41bb3337bf8751528b9c6f
JWT_REFRESH_SECRET=7e43b8c64456a3ca0a027565cb3b44c0a5b0a2841e30aa2226ae7640417a8b5e
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth Credentials
GOOGLE_CLIENT_ID=1014254344168-vvkkjne9a2c5rd37is3f8hcrapej8v7p.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-dxijMl7ys7GOp3fBA1U7oLzzmIl

# Email / SMTP Configuration (e.g., Gmail SMTP or SendGrid)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
# For Gmail SMTP, use an App Password, NOT your regular password
EMAIL_PASSWORD=abcd efgh ijkl mnop
EMAIL_FROM="MSMERAISE Auth <your_email@gmail.com>"

# OTP Security Configurations
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_INTERVAL_SECONDS=60

# Bcrypt Salt Rounds (Recommended: 10-12)
BCRYPT_ROUNDS=12

# Allowed CORS Origins (Comma-separated if multiple)
CORS_ORIGIN=http://localhost:3000
