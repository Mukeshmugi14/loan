# ==============================================================================
# FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env.development or .env.production and adjust the values.
# Vite requires variables accessed in client-side code to be prefixed with VITE_.

# Backend API base URL (Vite dev server or production backend API endpoint)
VITE_API_BASE_URL=http://localhost:5000/api

# Google OAuth Client ID (Must match the one used by Google Sign-In)
VITE_GOOGLE_CLIENT_ID=1014254344168-vvkkjne9a2c5rd37is3f8hcrapej8v7p.apps.googleusercontent.com
